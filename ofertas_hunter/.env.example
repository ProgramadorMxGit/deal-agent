# =============================================================================
# ofertas_hunter - .env.example
#
# Copia este archivo a .env y rellena con tus valores. NUNCA commitees el .env.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=INFO
ENV=development

# --- Database (SQLite WAL) --------------------------------------------------
DB_PATH=data/ofertas_hunter.db

# --- Marketplaces -----------------------------------------------------------
# Amazon MX
AMAZON_ENABLED=true
AMAZON_HEADLESS=true
AMAZON_MAX_PAGES_PER_SEED=10
AMAZON_DELAY_BETWEEN_PAGES_MS_MIN=5000
AMAZON_DELAY_BETWEEN_PAGES_MS_MAX=12000
# Sesión persistente del navegador (login manual con `python -m ofertas_hunter
# login --marketplace amazon`). Si se deja vacío, no usa perfil persistente.
AMAZON_USER_DATA_DIR=secrets/browser_profiles/amazon
AMAZON_WARMUP_HOMEPAGE=false

# Mercado Libre MX
MERCADOLIBRE_ENABLED=false
MERCADOLIBRE_HEADLESS=true
MERCADOLIBRE_COOKIES_PATH=secrets/mercadolibre_cookies.json
MERCADOLIBRE_COOKIES_FALLBACK_PATH=secrets/mercadolibre_cookies.example.json
MERCADOLIBRE_BROWSER_COOKIES_PATH=data/mercadolibre/browser_cookies.json
MERCADOLIBRE_SEEDS_PATH=config/seeds/mercadolibre.json
MERCADOLIBRE_MAX_CONCURRENCY=1
MERCADOLIBRE_REQUEST_DELAY_SECONDS=6
MERCADOLIBRE_BACKOFF_SECONDS=300
MERCADOLIBRE_SAVE_COOKIES_ON_EXIT=true
# REGLA DURA: ofertas de ML no se publican si no se obtuvo affiliate_url.
MERCADOLIBRE_AFFILIATE_REQUIRED_FOR_PUBLISH=true
MERCADOLIBRE_AFFILIATE_TIMEOUT_SECONDS=15
# Sesión persistente del navegador (login manual con `python -m ofertas_hunter
# login --marketplace mercadolibre`). Las cookies del JSON quedan como fallback.
MERCADOLIBRE_USER_DATA_DIR=secrets/browser_profiles/mercadolibre
# Compatibilidad con legacy:
BOT_DIVERSIDAD_GLOBAL_COOKIES_PATH=
OFERTAS_MELI_BROWSER_COOKIES_PATH=

# --- Scheduler nocturno ---------------------------------------------------
# Bot duerme entre 23:30 y 07:00 (zona MX). Entre 06:30 y 07:00 entra en
# "warmup": hunters/discovery activos pero NO publica todavía. A partir
# de 07:00 publica normalmente respetando cooldown.
SCHEDULE_ENABLED=true
SCHEDULE_TIMEZONE=America/Mexico_City
HIBERNATE_START=23:30
HIBERNATE_END=06:30
WARMUP_START=06:30
ACTIVE_START=07:00
WARMUP_LOOP_INTERVAL_SECONDS=90
HIBERNATION_CHECK_INTERVAL_SECONDS=60

# --- Telegram (Telethon) ----------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Compatibilidad con legacy:
OFERTAS_TELEGRAM_API_ID=
OFERTAS_TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=secrets/telegram.session
# Lista separada por comas. Acepta usernames o títulos exactos.
TELEGRAM_TARGET_CHANNELS=ofertonesmexico,OFERTAS PREMIUM MX,OFERTAS RELAMPAGO
# Alias legacy (si ambos existen, gana TELEGRAM_TARGET_CHANNELS):
TELEGRAM_CHANNELS=
TELEGRAM_BACKFILL_LIMIT_PER_CHANNEL=400
TELEGRAM_BACKFILL_PROCESS_BUDGET_PER_CHANNEL=40
TELEGRAM_CHANNEL_WORKERS=3
TELEGRAM_POLL_INTERVAL_SECONDS=30
TELEGRAM_IGNORE_MERCADOLIBRE_LINKS=true
TELEGRAM_LINK_RESOLVER_TIMEOUT_SECONDS=6
TELEGRAM_LINK_RESOLVER_MAX_REDIRECTS=5

# --- WhatsApp (Evolution API) -----------------------------------------------
WHATSAPP_ENABLED=false
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_TARGET_GROUP_ID=
# Alias requerido por la spec; si está set, gana sobre WHATSAPP_TARGET_GROUP_ID.
OFERTAS_WHATSAPP_GROUP_ID=
WHATSAPP_COOLDOWN_SECONDS=300
WHATSAPP_OUTBOX_REVALIDATE_AGE_SECONDS=3600

# Dispatcher: ENVÍO REAL DESACTIVADO POR DEFECTO. No tocar hasta autorización
# explícita del operador.
PUBLISHING_ENABLED=false
PUBLISHING_DRY_RUN=true
DISPATCHER_IDLE_SLEEP_SECONDS=5

# --- LLM evaluator (opcional) -----------------------------------------------
LLM_HEAL_ENABLED=false
LLM_BACKEND=none           # one of: kiro_cli | anthropic | none
ANTHROPIC_API_KEY=
KIRO_CLI_PATH=

# --- Scoring ----------------------------------------------------------------
PRICE_ERROR_THRESHOLD_CONFIRMED=80
PRICE_ERROR_THRESHOLD_POSSIBLE=60
PRICE_ERROR_THRESHOLD_SUSPICIOUS=40
NORMAL_OFFER_MIN_DISCOUNT=50
